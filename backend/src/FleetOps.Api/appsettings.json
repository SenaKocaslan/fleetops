{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "FleetOps": "Host=localhost;Port=5432;Database=fleetops;Username=fleetops;Password=fleetops"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  },
  "ResourceLock": {
    "Duration": "00:05:00",
    "ReaperInterval": "00:00:30"
  },
  "Outbox": {
    "PollInterval": "00:00:05",
    "BatchSize": 20
  }
}
