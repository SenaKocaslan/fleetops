# Kopyalayin: cp .env.example .env
# .env gitignore'da; sirlar depoya girmez.

# JWT imza anahtari. ZORUNLU, varsayilani YOK: varsayilan verilseydi
# herkesin bildigi bir anahtarla uretime cikmak mumkun olurdu.
# En az 32 bayt olmali. Uretmek icin:
#   openssl rand -base64 48
JWT_SIGNING_KEY=degistir-bunu-en-az-32-bayt-uzunlugunda-rastgele-bir-deger

# Asagidakiler istege bagli; bos birakilirsa parantez icindeki deger kullanilir.
#POSTGRES_DB=fleetops
#POSTGRES_USER=fleetops
#POSTGRES_PASSWORD=fleetops
#DB_CONNECTION=Host=db;Port=5432;Database=fleetops;Username=fleetops;Password=fleetops

#DB_PORT=55432      # host tarafinda veritabani portu
#API_PORT=5200      # host tarafinda API portu (5199 e2e tarafindan kullaniliyor)
#WEB_PORT=8080      # host tarafinda arayuz portu

#CORS_ORIGIN=http://localhost:4200
#SIMULATOR_ENABLED=true
