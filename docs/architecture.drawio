          <mxGeometry x="80" y="120" width="150" height="130" as="geometry" />
        </mxCell>
        <mxCell id="k1i" value="&lt;b&gt;Blazor&lt;/b&gt;&#160;&#160;filo panosu, gorev listesi&lt;br&gt;&lt;b&gt;SignalR&lt;/b&gt;&#160;&#160;AGV durumu canli guncellensin&lt;br&gt;&lt;b&gt;JWT + roller&lt;/b&gt;&#160;&#160;Operator / Supervisor ayrimi&lt;br&gt;&lt;b&gt;Minimal API&lt;/b&gt;&#160;&#160;AGV ve arayuz uc noktalari" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;verticalAlign=middle;spacingLeft=14;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="250" y="120" width="1170" height="130" as="geometry" />
        </mxCell>

        <mxCell id="k2" value="&lt;b&gt;Uygulama&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="80" y="275" width="150" height="160" as="geometry" />
        </mxCell>
        <mxCell id="k2i" value="&lt;b&gt;CQRS&lt;/b&gt;&#160;&#160;yazma aggregate'ten, okuma projeksiyondan&lt;br&gt;&lt;b&gt;Decorator&lt;/b&gt;&#160;&#160;log ve transaction handler'i kirletmesin&lt;br&gt;&lt;b&gt;Strategy&lt;/b&gt;&#160;&#160;atama kurali degisebilir olsun&lt;br&gt;&lt;b&gt;Result&lt;/b&gt;&#160;&#160;beklenen is hatalari istisna olmadan donsun&lt;br&gt;&lt;b&gt;Options&lt;/b&gt;&#160;&#160;kilit suresi, batarya esigi koda gomulmesin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;verticalAlign=middle;spacingLeft=14;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="250" y="275" width="1170" height="160" as="geometry" />
        </mxCell>

        <mxCell id="k3" value="&lt;b&gt;Domain&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="80" y="460" width="150" height="130" as="geometry" />
        </mxCell>
        <mxCell id="k3i" value="&lt;b&gt;Aggregate + rich domain&lt;/b&gt;&#160;&#160;gecersiz durum gecisi imkansiz olsun&lt;br&gt;&lt;b&gt;State machine&lt;/b&gt;&#160;&#160;gecisler tek yerde tanimli olsun&lt;br&gt;&lt;b&gt;Domain events&lt;/b&gt;&#160;&#160;aggregate ne oldugunu duyursun&lt;br&gt;&lt;i&gt;Bu katmanda hicbir NuGet paketi yoktur.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;align=left;verticalAlign=middle;spacingLeft=14;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="250" y="460" width="1170" height="130" as="geometry" />
        </mxCell>

        <mxCell id="k4" value="&lt;b&gt;Altyapi&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="80" y="615" width="150" height="185" as="geometry" />
        </mxCell>
        <mxCell id="k4i" value="&lt;b&gt;EF Core 10 + Npgsql&lt;/b&gt;&#160;&#160;modul basina DbContext ve migration&lt;br&gt;&lt;b&gt;Optimistic concurrency&lt;/b&gt;&#160;&#160;gorev/kilit iki kez verilmesin&lt;br&gt;&lt;b&gt;Repository&lt;/b&gt;&#160;&#160;aggregate butun olarak yuklensin/kaydedilsin&lt;br&gt;&lt;b&gt;Outbox&lt;/b&gt;&#160;&#160;kayit gitti ama olay gitmedi durumu olmasin&lt;br&gt;&lt;b&gt;IHostedService&lt;/b&gt;&#160;&#160;takili kilitler serbest kalsin, outbox islensin&lt;br&gt;&lt;b&gt;PostgreSQL&lt;/b&gt;&#160;&#160;jsonb, satir kilidi, guclu transaction destegi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=left;verticalAlign=middle;spacingLeft=14;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="250" y="615" width="1170" height="185" as="geometry" />
        </mxCell>

        <mxCell id="k5" value="&lt;b&gt;Capraz&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="80" y="825" width="150" height="130" as="geometry" />
        </mxCell>
        <mxCell id="k5i" value="&lt;b&gt;xUnit + NSubstitute&lt;/b&gt;&#160;&#160;domain ve handler birim testleri, veritabanisiz&lt;br&gt;&lt;b&gt;Testcontainers&lt;/b&gt;&#160;&#160;concurrency gercek PostgreSQL'e karsi kanitlanir&lt;br&gt;&lt;b&gt;Docker Compose&lt;/b&gt;&#160;&#160;tek komutla kurulum&lt;br&gt;&lt;b&gt;ILogger + scope&lt;/b&gt;&#160;&#160;bir gorevin izi loglardan surulsun" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;align=left;verticalAlign=middle;spacingLeft=14;fontSize=13;" vertex="1" parent="1">
