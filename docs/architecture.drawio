        <mxCell id="a6" value="EF Core" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;fontSize=12;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="inf" target="db"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="not" value="&lt;b&gt;Bagimlilik kurali&lt;/b&gt;&lt;br&gt;Ok yonu iceri bakar. Infrastructure, Application'da tanimli&lt;br&gt;arayuzleri uygular; Application onu tanimaz. Domain hicbir&lt;br&gt;seye bakmaz ve hicbir paket icermez.&lt;br&gt;&lt;br&gt;&lt;b&gt;Strategy: IAssignmentPolicy&lt;/b&gt;&lt;br&gt;Gorevi hangi AGV alacak? En yakin mi, en dolu bataryali mi,&lt;br&gt;en az mesgul mu &#8212; politika degisebilir olmali.&lt;br&gt;&lt;br&gt;&lt;b&gt;Repository: ITransportTaskRepository&lt;/b&gt;&lt;br&gt;Aggregate'i butun olarak yukler ve kaydeder. GameStore'da&lt;br&gt;kaldirdigimiz CRUD sarmalayicisi degil." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="565" width="320" height="235" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="teknoloji" name="Teknoloji Haritasi">
